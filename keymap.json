// ═══════════════════════════════════════════════════════════════════════════════
// QUICK SHORTCUTS REFERENCE
// ═══════════════════════════════════════════════════════════════════════════════
//
// Editor — Editing
//   Ctrl+E               toggle comment / uncomment
//   Shift+Alt+Z/S        move line up / down
//   Alt+Enter            insert line below
//
// Editor — Viewport
//   Alt+O / Alt+N        scroll page up / down
//
// Editor — Cursor
//   Alt+Z / Alt+S        line up / down
//   Alt+K / Alt+J        5 lines up / down
//   Alt+Q / Alt+D        character left / right
//   Alt+W                beginning of line
//   Alt+F                end of line
//   Alt+H / Alt+L        previous / next word
//
// Editor — Selection
//   Alt+E                expand syntax selection
//   Shift+Alt+Q/D        select character left / right
//   Shift+Alt+K/J        select line up / down
//   Shift+Alt+H/L        select subword left / right
//
// Editor — Deletion
//   Alt+U / Alt+I        backspace / delete
//   Shift+Alt+I          delete entire line
//   Ctrl+Alt+U/I         delete word left / right
//
// Tabs (AZERTY)
//   Alt+& (Alt+1)        previous tab in pane
//   Alt+à (Alt+0)        next tab in pane
//   Alt+é (Alt+2)        open tab switcher
//
// Workspace
//   Ctrl+Alt+H/L         focus pane left / right
//   Ctrl+Alt+K/J         focus pane up / down
//   Alt+X                toggle outline (symbols)
//   Ctrl+Alt+N           Git panel (toggle)
//   Ctrl+Alt+G           focus Git panel
//
// ProjectPanel
//   Alt+K / Alt+J        previous / next item
//
// Search
//   Ctrl+Alt+F           focus project search (or deploy if already focused)
// ═══════════════════════════════════════════════════════════════════════════════
//

[
  // ─── Editor ────────────────────────────────────────────────────────────────
  {
    "context": "Editor",
    "bindings": {
      // Édition
      "ctrl-e": "editor::ToggleComments",
      "shift-alt-z": "editor::MoveLineUp",
      "shift-alt-s": "editor::MoveLineDown",
      "alt-enter": "editor::NewlineBelow",

      // Viewport
      "alt-o": "editor::PageUp",
      "alt-n": "editor::PageDown",

      // Curseur
      "alt-z": "editor::MoveUp",
      "alt-s": "editor::MoveDown",
      "alt-k": ["editor::MoveUpByLines", { "lines": 5 }],
      "alt-j": ["editor::MoveDownByLines", { "lines": 5 }],
      "alt-q": "editor::MoveLeft",
      "alt-d": "editor::MoveRight",
      "alt-w": "editor::MoveToBeginningOfLine",
      "alt-f": "editor::MoveToEndOfLine",
      "alt-h": "editor::MoveToPreviousWordStart",
      "alt-l": "editor::MoveToNextWordEnd",

      // Sélection
      "alt-e": "editor::SelectLargerSyntaxNode",
      "shift-alt-q": "editor::SelectLeft",
      "shift-alt-d": "editor::SelectRight",
      "shift-alt-k": "editor::SelectUp",
      "shift-alt-j": "editor::SelectDown",
      "shift-alt-h": "editor::SelectToPreviousSubwordStart",
      "shift-alt-l": "editor::SelectToNextSubwordEnd",

      // Suppression
      "alt-u": "editor::Backspace",
      "alt-i": "editor::Delete",
      "shift-alt-i": "editor::DeleteLine",
      "ctrl-alt-u": "editor::DeleteToPreviousWordStart",
      "ctrl-alt-i": "editor::DeleteToNextWordEnd",
    },
  },

  // ─── Pane ──────────────────────────────────────────────────────────────────
  {
    "context": "Pane",
    "bindings": {
      "alt-à": "pane::ActivateNextItem",
      "alt-&": "pane::ActivatePreviousItem",
      "alt-é": ["tab_switcher::Toggle", { "select_last": false }],
    },
  },

  // ─── Workspace ─────────────────────────────────────────────────────────────
  {
    "context": "Workspace",
    "bindings": {
      "alt-x": "outline::Toggle",
      "ctrl-alt-h": "workspace::ActivatePaneLeft",
      "ctrl-alt-l": "workspace::ActivatePaneRight",
      "ctrl-alt-k": "workspace::ActivatePaneUp",
      "ctrl-alt-j": "workspace::ActivatePaneDown",
    },
  },

  // ─── ProjectPanel ─────────────────────────────────────────────────────────────
  {
    "context": "ProjectPanel",
    "bindings": {
      "alt-k": "menu::SelectPrevious",
      "alt-j": "menu::SelectNext",
    },
  },

  // ─── Search ─────────────────────────────────────────────────────────────
  {
    "context": "ProjectSearchBar",
    "bindings": {
      "ctrl-alt-f": "search::FocusSearch",
    },
  },
  {
    "context": "Pane",
    "bindings": {
      "ctrl-alt-f": "project_search::ToggleFocus",
    },
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-alt-f": "pane::DeploySearch",
    },
  },
  {
    "context": "Terminal",
    "bindings": {
      "ctrl-alt-f": "buffer_search::Deploy",
    },
  },

  // ─── Unbind globaux ────────────────────────────────────────────────────────
  {
    "unbind": {
      "alt-shift-l": "lsp_tool::ToggleMenu",
    },
  },
  {
    "context": "AgentPanel",
    "unbind": {
      "alt-shift-l": "agent::OpenRulesLibrary",
    },
  },
  {
    "context": "Pane",
    "unbind": {
      "alt-&": ["pane::ActivateItem", 0],
      "alt-é": ["pane::ActivateItem", 1],
      "alt-à": "pane::ActivateLastItem",
    },
  },
  {
    "context": "Workspace",
    "unbind": {
      "alt-é": ["workspace::ActivatePane", 1],
    },
  },
  {
    "context": "GitPanel && ChangesList && !GitBranchSelector",
    "unbind": {
      "up": "git_panel::PreviousEntry",
    },
  },
  {
    "context": "RunModal",
    "unbind": {
      "ctrl-tab": "pane::ActivateNextItem",
    },
  },
  {
    "context": "Workspace",
    "unbind": {
      "ctrl-shift-:": "agent::ToggleFocus",
    },
  },
  {
    "bindings": {
      "ctrl-alt-n": "git_panel::Toggle",
    },
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-alt-g": "git_panel::ToggleFocus",
    },
  },
  {
    "context": "Workspace",
    "unbind": {
      "ctrl-shift-g": "git_panel::ToggleFocus",
    },
  },
  {
    "context": "Terminal",
    "unbind": {
      "ctrl-shift-f": "buffer_search::Deploy",
    },
  },
  {
    "context": "Workspace",
    "unbind": {
      "ctrl-shift-f": "pane::DeploySearch",
    },
  },
  {
    "context": "Pane",
    "unbind": {
      "ctrl-shift-f": "project_search::ToggleFocus",
    },
  },
  {
    "context": "ProjectSearchBar",
    "unbind": {
      "ctrl-shift-f": "search::FocusSearch",
    },
  },
]
